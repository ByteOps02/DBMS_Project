# Database 
# Pooled connection — used by Prisma Client at runtime
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Direct connection — required by prisma migrate (DDL operations)
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# JWT 
JWT_SECRET="your-super-secret-jwt-key-at-least-32-chars"

# Cloudinary 
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS 
# The deployed frontend URL (no trailing slash), e.g.:
# FRONTEND_URL=https://vms-frontend.vercel.app
# For local dev, leave as http://localhost:5174
FRONTEND_URL=http://localhost:5174

# Server
PORT=5000
NODE_ENV=development

# Email (Resend for OTPs and Visit Notifications) 
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL="IIIT Nagpur VMS <iiitnagpur_vms@resend.dev>"
