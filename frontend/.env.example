# ─── API ─────────────────────────────────────────────────────────────────────
# Base URL of the deployed backend (no trailing slash).
# Leave empty for local dev (Vite proxy handles /api/* → localhost:5000).
# In production set this to your Vercel backend URL, e.g.:
#   VITE_API_BASE_URL=https://vms-backend.vercel.app
VITE_API_BASE_URL=

# ─── EmailJS ─────────────────────────────────────────────────────────────────
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=your-public-key-here
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_APPROVAL_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_DENIAL_TEMPLATE_ID=template_xxxxxxx

# ─── Dev server ──────────────────────────────────────────────────────────────
VITE_PORT=5174
